# Copy this file to .env.local and fill in the values.
# On Vercel, set the same variables under Project Settings > Environment Variables.

# Where the app lives. No trailing slash.
# Production: https://uvl.nelsonstrategygroup.com   Development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase dashboard > Project Settings > API (or "API Keys").
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret key (sb_secret_...) or the legacy "service_role" key.
# SERVER ONLY. Never give it a NEXT_PUBLIC_ prefix and never share it.
SUPABASE_SERVICE_ROLE_KEY=
